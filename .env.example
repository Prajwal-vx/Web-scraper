# NEXUS SCRAPE AI — Configuration Template

# Server & Environment
APP_NAME="NEXUS SCRAPE AI"
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security (JWT & Token Hashing)
SECRET_KEY=change-me-to-a-secure-32-byte-hex-string-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default standalone: SQLite (zero external installation required)
DATABASE_URL=sqlite:///./nexus_scrape.db
# PostgreSQL for production:
# DATABASE_URL=postgresql://nexus:nexus_password@localhost:5432/nexus_scrape

# Redis (Optional)
# REDIS_URL=redis://localhost:6379/0

# Crawling Limits & Delays
MAX_RESPONSE_SIZE_BYTES=10485760
DEFAULT_CRAWL_DELAY_SECONDS=1.0
DEFAULT_MAX_CONCURRENT_JOBS=4
MAX_PAGES_HARD_LIMIT=500
REQUEST_TIMEOUT_SECONDS=15

# Browser Worker (Playwright)
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_TIMEOUT_SECONDS=20

# AI Provider Settings (Optional)
# Choices: heuristic (default, zero-cost, local), openai, gemini, anthropic
AI_PROVIDER=heuristic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_MODEL_NAME=gpt-4o-mini
